{
  "name": "pixel-snake",
  "version": "2.4.0-beta",
  "description": "Pixel snake game inspired by slitherio",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm -r --filter=!@pixel-snake/lab-server --reporter=append-only start",
    "dev": "pnpm -r dev",
    "lab": "pnpm --filter @pixel-snake/lab-server start",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @pixel-snake/lab-server db:migrate",
    "test": "pnpm --filter @pixel-snake/backend --filter @pixel-snake/lab-server test"
  },
  "keywords": [],
  "author": "Komornikx",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
